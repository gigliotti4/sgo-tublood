{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        // Los .d.ts de las dependencias no son asunto nuestro: @inertiajs/core
        // referencia axios, que ya no viene instalado.
        "skipLibCheck": true,
        "jsx": "preserve",
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "types": ["vite/client"]
    },
    "include": ["resources/js/**/*", "resources/js/**/*.d.ts"]
}
