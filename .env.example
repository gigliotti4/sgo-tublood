APP_NAME="SGO Tublood"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sgo-tublood
DB_USERNAME=root
DB_PASSWORD=

# API RP Sistemas — Integrador de Pedidos v2
RPSISTEMAS_API_BASE_URL=https://api.comprobantesonline.com.ar/v2
RPSISTEMAS_API_TOKEN=           # Bearer token proporcionado por RP Sistemas
# RPSISTEMAS_API_PAGE_SIZE=100  # Registros por página al sincronizar (default 100)

# Base SQL de RP Sistemas (SOLO LECTURA) — proveedores y ventas no tienen API,
# solo vistas SQL, las mismas que consumen desde Power BI.
# Requiere la extensión pdo_sqlsrv + Microsoft ODBC Driver 18: no vienen
# instalados por defecto y NO se pueden instalar en hosting compartido.
ERP_DB_HOST=            # IP del servidor SQL, sin el puerto
ERP_DB_PORT=            # el puerto va aparte: Laravel arma "host,puerto"
ERP_DB_DATABASE=
ERP_DB_USERNAME=
ERP_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=600

BROADCAST_CONNECTION=reverb
BROADCAST_NOTIFICATION_CONNECTION=deferred
BROADCAST_EVENT_CONNECTION=sync
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# En dev queda en "log": los mails se leen en storage/logs/laravel.log.
# En producción: MAIL_MAILER=resend + RESEND_API_KEY, y MAIL_FROM_ADDRESS tiene
# que ser de un dominio verificado en Resend (si no, rechaza el envío).
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tublood.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"

# Produccion en hosting compartido: usar BROADCAST_CONNECTION=pusher y
# completar estas credenciales desde el panel de Pusher Channels.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
