# Los assets compilados se versionaban a propósito mientras el deploy fue a
# Hostinger, que no tenía Node. El droplet sí lo tiene y `deploy.sh` corre
# `npm run build`, así que dejan de estar en el repo — eran ~50 archivos con
# hash que cambiaban en cada commit del frontend.
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
/database/*.sqlite
/database/*.sqlite-wal
/database/*.sqlite-shm

# Notas de trabajo en la raíz: planes, informes y minutas de reunión. Quedan
# locales a propósito. La documentación que sí se versiona vive en /docs
# (más CLAUDE.md, README.md y DEPLOY-HOSTINGER-RUNBOOK.md, ya trackeados).
/GUIA-FUNCIONAL-SGO.md
/INFORME-*.md
/PLAN-*.md
/PREGUNTAS-*.md
/PROMPT-*.md
/Reunion.md

# Planillas con datos de personas o de clientes: el repo es publico y estos
# archivos se generan/descargan a mano, no son parte del codigo.
/usuarios-*.xlsx
/clientes-*.xlsx
/proveedores-*.xlsx
/observaciones-*.xlsx
